<form class="callback-card" action="/api/contact" method="post" data-quick-callback>
  <div class="callback-heading">
    <div class="callback-title">
      <span class="callback-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" /></svg></span>
      <div>
        <p class="eyebrow">LET'S TALK ABOUT YOUR STORAGE</p>
        <h2>Request a call back</h2>
        <p>Leave your name and best contact. We’ll be in touch within 24 hours.</p>
      </div>
    </div>
    <a href="tel:098184586" aria-label="Call West Auckland Storage on 09 818 4586">09 818 4586</a>
  </div>
  <div class="callback-fields">
    <label>Your name<input name="name" required autocomplete="name" placeholder="Your name" /></label>
    <label>Phone or email<input name="contact" required autocomplete="tel" placeholder="Best number or email" /></label>
    <input type="hidden" name="item" value="Callback request" />
    <input type="hidden" name="message" value="Please call me back." />
    <input type="hidden" name="page" value="homepage-callback" />
    <div class="callback-honeypot" aria-hidden="true"><label>Leave this field empty<input name="company" tabindex="-1" autocomplete="off" /></label></div>
    <button class="button button-bright callback-submit" type="submit">Request a call back</button>
  </div>
  <p class="callback-status" role="status" aria-live="polite"></p>
</form>

<style>
  .callback-card { width:100%; margin:0; padding:26px; border:1px solid rgba(255,255,255,.8); border-radius:8px; background:#f5f8fa; color:#12283d; box-shadow:0 22px 60px rgba(0,0,0,.28); }
  .callback-heading { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:14px; }
  .callback-title { display:flex; align-items:center; gap:12px; min-width:0; }
  .callback-icon { display:grid; flex:none; width:44px; height:44px; place-items:center; border:1px solid #b8c9d6; border-radius:50%; background:#fff; color:#145693; }
  .callback-icon svg { width:20px; height:20px; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .callback-heading .eyebrow { margin:0 0 8px; color:#145693; font-size:11px; }
  .callback-heading h2 { margin:0 0 7px; color:#082e54; font-size:clamp(25px,2.3vw,32px); line-height:1.05; }
  .callback-heading p:not(.eyebrow) { margin:0; color:#40576a; font-size:14px; line-height:1.5; }
  .callback-heading > a { flex:0 0 auto; color:#145693; font-weight:700; text-decoration-thickness:1px; text-underline-offset:3px; }
  .callback-fields { display:grid; grid-template-columns:1fr 1fr; align-items:end; gap:13px 11px; }
  .callback-fields label { display:grid; gap:6px; color:#20394e; font-size:12px; font-weight:700; }
  .callback-fields input:not([type=hidden]) { width:100%; min-height:46px; padding:9px 11px; border:1px solid #b8c9d6; border-radius:4px; background:#fff; color:#172b3c; font:inherit; }
  .callback-fields input:focus-visible { outline:3px solid #9bd1f5; outline-offset:2px; }
  .callback-submit { grid-column:1 / -1; min-height:50px; padding:11px 16px; white-space:nowrap; cursor:pointer; }
  .callback-status { margin:10px 0 0; color:#20394e; line-height:1.45; }
  .callback-status:empty { display:none; }
  .callback-honeypot { position:absolute!important; left:-10000px!important; width:1px!important; height:1px!important; overflow:hidden!important; }
  @media(max-width:680px) { .callback-card { padding:18px; } .callback-heading { align-items:flex-start; flex-direction:column; gap:10px; } .callback-fields { grid-template-columns:1fr; } .callback-submit { width:100%; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-quick-callback]');
  const status = form?.querySelector<HTMLElement>('.callback-status');
  const submit = form?.querySelector<HTMLButtonElement>('[type="submit"]');

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    if (submit) submit.disabled = true;
    if (status) status.textContent = 'Sending your request…';
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(data.entries())),
      });
      const result = await response.json();
      if (!response.ok || result.ok !== true) throw new Error('Callback request was not delivered');
      form.reset();
      try { sessionStorage.setItem('wast-exit-callback-shown', 'yes'); } catch {}
      if (status) status.textContent = 'Thanks — your request is on its way. We’ll be in touch within 24 hours.';
    } catch {
      if (status) status.textContent = 'We couldn’t send that request just now. Your details are still here. Please try again or call 09 818 4586.';
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>