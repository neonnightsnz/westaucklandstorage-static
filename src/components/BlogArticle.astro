---
import { posts, categoryFor, categoryLabel } from '../data/blog';
import { formatPostDate, postYear } from '../data/dates';
import { storageOptions } from '../data/sitePages';
import { locationGroups } from '../data/locations';
import { locationPages } from '../data/locationPages';
import Breadcrumbs from './Breadcrumbs.astro';
const { post } = Astro.props;
const category = categoryFor(post.slug);
const categoryName = categoryLabel(category);
const localGroup = locationGroups.find(group => group.suburbs.some(suburb => suburb.slug === post.slug));
const localPeers = localGroup?.suburbs.map(suburb => suburb.slug).filter(slug => slug && slug !== post.slug) ?? [];
// The storage-near page for this suburb, if the guide has one. Suburbs we serve
// without a guide have no slug, so no page is linked.
const localPage = locationPages.find(page => page.guideSlug === post.slug);
const preferred = category === 'local-guides'
  ? [storageOptions[0].slug, ...localPeers]
  : category === 'storage-options'
    ? ['why-choose-west-auckland-storage-for-your-long-term-storage-needs', 'why-choose-west-auckland-storage-for-your-short-term-storage-needs', 'boat-storage-at-west-auckland-storage']
    : storageOptions.slice(0, 3).map(option => option.slug);
const related = [...new Set(preferred)].filter(slug => slug !== post.slug).map(slug => posts.find(item => item.slug === slug)).filter(Boolean).slice(0, 3);
const serviceLinks = storageOptions.filter(option => option.slug !== post.slug).slice(0, 3);
const enquiryItems: Record<string, string> = {
  'boat-storage-at-west-auckland-storage': 'Boat',
  'caravan-storage-at-west-auckland-storage': 'Caravan',
  'vehicle-storage-at-west-auckland-storage': 'Vehicle or other gear',
  'shipping-container-storage-at-west-auckland-storage': 'Shipping container',
  'trailer-storage-at-west-auckland-storage': 'Trailer',
  'truck-storage-at-west-auckland-storage': 'Truck',
  'outdoor-storage-solutions-at-west-auckland-storage': 'Vehicle or other gear',
  'uncovered-boat-storage-at-west-auckland-storage': 'Boat',
  'business-storage-solutions-at-west-auckland-storage': 'Business equipment',
};
const enquiryItem = enquiryItems[post.slug];
const contactHref = enquiryItem ? `/contact/?${new URLSearchParams({ item: enquiryItem, from: `/${post.slug}/` })}#enquiry` : '/contact/#enquiry';
---
<main id="main">
  <header class="article-header section-pad">
    <div class="container">
      <Breadcrumbs />
      <p class="eyebrow">From the yard</p>
      <h1>{post.title}</h1>
      <p class="article-meta"><time datetime={post.date}>{formatPostDate(post.date)}</time> · By <a href="/author/isaac/">{post.author}</a> · <a href={`/category/${category}/`}>{categoryName}</a></p>
    </div>
  </header>
  <section class="page-content section-pad article-section">
    <div class="container article-grid">
      <article class="prose article-prose">
        <img class="article-image" src={post.image} alt={post.imageAlt} width="1200" height="800" fetchpriority="high" />
        <div set:html={post.content} />
        <a class="text-link" href="/blog/">← All articles</a>
      </article>
      <aside class="page-aside aside-card">
        <p class="eyebrow">Find your space</p>
        <h2>Storage close to home.</h2>
        <p>Talk to the yard about space for your boat, caravan, trailer or vehicle.</p>
        <a class="button button-bright" href={contactHref}>Ask about space →</a>
        <a class="article-aside-link" href="tel:098184586">Call 09 818 4586</a>
        <a class="article-aside-link" href="/services/">Explore our storage options</a>
        <a class="article-aside-link" href="/storage-near-you/">Storage near you</a>
        {localPage && <a class="article-aside-link" href={`/${localPage.slug}/`}>Storage near {localPage.suburb}</a>}
        <nav aria-label="Storage options for this guide">
          {serviceLinks.map(option => <a class="article-aside-link" href={`/${option.slug}/`}>{option.label} in Glendene</a>)}
        </nav>
        <p class="archive-note">This article was published in {postYear(post.date)}. Please check with the yard for current facilities, access and availability.</p>
        {enquiryItem && <p class="archive-note">September 2026 website note. Prices, space and slipway access can change. Confirm your requirements with Jeff before bringing anything to the yard.</p>}
      </aside>
    </div>
  </section>
  <nav class="related-section section-pad" aria-label="More articles">
    <div class="container">
      <p class="eyebrow">Keep reading</p>
      <div class="related-grid">
        {related.map(item => <a class="related-card" href={`/${item.slug}/`}><h3>{item.title}</h3><span class="text-link">Read article →</span></a>)}
      </div>
    </div>
  </nav>
</main>
