<form class="quote-form" data-contact-form method="post" action="mailto:info@westaucklandstorage.co.nz">
  <div class="form-row">
    <label>Your name <input name="name" required autocomplete="name" /></label>
    <label>Phone or email <input name="contact" required /></label>
  </div>
  <label>What are you storing?
    <select name="item" required>
      <option value="">Choose one</option>
      <option>Boat</option><option>Caravan</option><option>Trailer</option><option>Vehicle or other gear</option>
    </select>
  </label>
  <label>Anything else we should know? <textarea name="message" rows="4" placeholder="Size, timing, access needs…"></textarea></label>
  <div class="form-honey" aria-hidden="true">
    <label>Leave this field empty <input name="company" tabindex="-1" autocomplete="off" /></label>
  </div>
  <button class="button button-bright" type="submit">Send enquiry</button>
  <p class="form-note">We’ll come back to you with the next step. Prefer to talk? Call <a href="tel:098184586">09 818 4586</a>.</p>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<script>
  // Submit in-page via /api/contact. If the endpoint is unavailable (no
  // provider configured yet, or offline) fall back to a mailto: draft so
  // the enquiry is never lost.
  const mailDraft = (data: FormData) => {
    const body = [`Name: ${data.get('name')}`, `Phone or email: ${data.get('contact')}`, `Storing: ${data.get('item')}`, `Details: ${data.get('message') || 'None provided'}`].join('\n');
    window.location.href = `mailto:info@westaucklandstorage.co.nz?subject=${encodeURIComponent(`Storage enquiry from ${data.get('name')}`)}&body=${encodeURIComponent(body)}`;
  };

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(form => {
    const status = form.querySelector<HTMLElement>('.form-status');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const setStatus = (text: string) => { if (status) status.textContent = text; };

    form.addEventListener('submit', async event => {
      event.preventDefault();
      const data = new FormData(form);
      submit?.setAttribute('disabled', 'true');
      setStatus('Sending your enquiry…');
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name: data.get('name'),
            contact: data.get('contact'),
            item: data.get('item'),
            message: data.get('message'),
            company: data.get('company'),
            page: window.location.pathname,
          }),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        form.reset();
        setStatus('Thanks — your enquiry is on its way. We’ll be in touch. Prefer to talk? Call 09 818 4586.');
      } catch {
        mailDraft(data);
        setStatus('We couldn’t send that just now, so we’ve opened an email draft instead. If nothing happens, call 09 818 4586.');
      } finally {
        submit?.removeAttribute('disabled');
      }
    });
  });
</script>
