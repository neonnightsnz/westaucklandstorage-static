---
import { posts } from '../data/blog';
const index = posts.map(post => ({
  title: post.title, url: `/${post.slug}/`, excerpt: post.excerpt,
  text: `${post.title} ${post.excerpt} ${post.content.replace(/<[^>]*>/g, ' ')}`,
}));
---
<section class="blog-search" data-blog-search data-index={JSON.stringify(index)} hidden aria-label="Search all articles">
  <label for="blog-query">Search all articles</label>
  <div class="blog-search-controls">
    <input id="blog-query" type="search" placeholder="Try caravan, slipway or a suburb" autocomplete="off" aria-controls="blog-search-results" />
    <button class="button button-bright" type="button" data-search-clear>Clear search</button>
  </div>
  <p role="status" aria-live="polite" data-search-status></p>
  <div id="blog-search-results" class="search-results" hidden></div>
</section>
<script>
  const search = document.querySelector<HTMLElement>('[data-blog-search]');
  if (search) {
    const entries: { title: string; url: string; excerpt: string; text: string }[] = JSON.parse(search.dataset.index || '[]');
    const input = search.querySelector<HTMLInputElement>('input')!;
    const results = search.querySelector<HTMLElement>('#blog-search-results')!;
    const status = search.querySelector<HTMLElement>('[data-search-status]')!;
    const archive = document.querySelector<HTMLElement>('[data-archive-list]')!;
    const normalise = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const indexed = entries.map(entry => ({ ...entry, text: normalise(entry.text) }));
    const update = () => {
      const words = normalise(input.value.trim()).split(/\s+/).filter(Boolean);
      archive.hidden = words.length > 0;
      results.hidden = words.length === 0;
      results.replaceChildren();
      if (!words.length) { status.textContent = ''; return; }
      const matches = indexed.filter(entry => words.every(word => entry.text.includes(word)));
      status.textContent = matches.length ? `${matches.length} ${matches.length === 1 ? 'article' : 'articles'} found.` : 'No articles found. Try a different topic or suburb.';
      for (const entry of matches) {
        const article = document.createElement('article');
        const heading = document.createElement('h2');
        const link = document.createElement('a');
        link.href = entry.url;
        link.textContent = entry.title;
        const excerpt = document.createElement('p');
        excerpt.textContent = entry.excerpt;
        heading.append(link);
        article.append(heading, excerpt);
        results.append(article);
      }
    };
    input.addEventListener('input', update);
    search.querySelector('[data-search-clear]')!.addEventListener('click', () => { input.value = ''; update(); input.focus(); });
    search.hidden = false;
  }
</script>
