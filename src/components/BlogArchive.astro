---
import { pageSize, archivePath } from '../data/blog';
import { formatPostDate } from '../data/dates';
import Breadcrumbs from './Breadcrumbs.astro';
import BlogSearch from './BlogSearch.astro';
const { archive } = Astro.props;
const selected = archive.items.slice((archive.number - 1) * pageSize, archive.number * pageSize);
const heading = archive.label;
---
<main id="main">
  <header class="inner-hero archive-header">
    <div class="container inner-hero-content">
      <Breadcrumbs />
      <p class="eyebrow eyebrow-light">Storage notes & local guides</p>
      <h1>{heading}{archive.number > 1 ? ` — Page ${archive.number}` : ''}</h1>
      <p class="hero-lede">{archive.description}</p>
      <p class="article-meta">Page {archive.number} of {archive.pageCount} · {archive.total} articles</p>
    </div>
  </header>
  <section class="section-pad">
    <div class="container">
      <BlogSearch />
      <div data-archive-list>
      <div class="blog-grid">
        {selected.map((post, i) => <article class="blog-card">
          <a href={`/${post.slug}/`} tabindex="-1" aria-hidden="true"><img src={post.image} alt="" width="640" height="420" loading={i < 2 ? 'eager' : 'lazy'} /></a>
          <div class="blog-card-body">
            <time class="article-meta" datetime={post.date}>{formatPostDate(post.date)}</time>
            <h2><a href={`/${post.slug}/`}>{post.title}</a></h2>
            <p>{post.excerpt.length > 220 ? `${post.excerpt.slice(0, 217).replace(/\s+\S*$/, '')}…` : post.excerpt}</p>
            <a class="text-link" href={`/${post.slug}/`} aria-label={`Read ${post.title}`}>Read article →</a>
          </div>
        </article>)}
      </div>
      <nav class="pagination" aria-label="Article pages">
        {archive.number > 1 && <a rel="prev" href={archivePath(archive.base, archive.number - 1)}>← Previous</a>}
        {Array.from({ length: archive.pageCount }, (_, i) => <a href={archivePath(archive.base, i + 1)} aria-label={`Page ${i + 1}`} aria-current={archive.number === i + 1 ? 'page' : undefined}>{i + 1}</a>)}
        {archive.number < archive.pageCount && <a rel="next" href={archivePath(archive.base, archive.number + 1)}>Next →</a>}
      </nav>
      </div>
    </div>
  </section>
</main>
