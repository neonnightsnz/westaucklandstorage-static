---
import { posts, pageSize, pageCount, archivePath } from '../data/blog';
const { archive } = Astro.props;
const selected = posts.slice((archive.number - 1) * pageSize, archive.number * pageSize);
const heading = archive.base === 'author/isaac' ? 'Articles by Isaac' : archive.base === 'category/uncategorized' ? 'Uncategorized' : 'From the yard.';
---
<main id="main">
  <header class="article-header archive-header section-pad">
    <div class="container">
      <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog/">Blog</a></nav>
      <p class="eyebrow">Storage notes & local guides</p>
      <h1>{heading}</h1>
      <p class="archive-intro">Boat, caravan and vehicle storage advice, and guides for our West Auckland neighbours.</p>
      <p class="article-meta">Page {archive.number} of {pageCount} · {posts.length} articles</p>
    </div>
  </header>
  <section class="section-pad">
    <div class="container">
      <div class="blog-grid">
        {selected.map((post, i) => <article class="blog-card">
          <a href={`/${post.slug}/`} tabindex="-1" aria-hidden="true"><img src={post.image} alt="" width="640" height="420" loading={i < 2 ? 'eager' : 'lazy'} /></a>
          <div class="blog-card-body">
            <time class="article-meta" datetime={post.date}>{post.dateLabel}</time>
            <h2><a href={`/${post.slug}/`}>{post.title}</a></h2>
            <p>{post.excerpt.length > 220 ? `${post.excerpt.slice(0, 217).replace(/\s+\S*$/, '')}…` : post.excerpt}</p>
            <a class="text-link" href={`/${post.slug}/`} aria-label={`Read ${post.title}`}>Read article →</a>
          </div>
        </article>)}
      </div>
      <nav class="pagination" aria-label="Article pages">
        {archive.number > 1 && <a rel="prev" href={archivePath(archive.base, archive.number - 1)}>← Previous</a>}
        {Array.from({ length: pageCount }, (_, i) => <a href={archivePath(archive.base, i + 1)} aria-label={`Page ${i + 1}`} aria-current={archive.number === i + 1 ? 'page' : undefined}>{i + 1}</a>)}
        {archive.number < pageCount && <a rel="next" href={archivePath(archive.base, archive.number + 1)}>Next →</a>}
      </nav>
    </div>
  </section>
</main>
