---
import QuoteForm from "../components/QuoteForm.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { pages, storageOptions } from "../data/sitePages";
import { posts, archives } from "../data/blog";
import { locationGroups } from "../data/locations";
import BlogArticle from "../components/BlogArticle.astro";
import BlogArchive from "../components/BlogArchive.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

export const prerender = true;

export function getStaticPaths() {
  return [...pages.filter(page => !posts.some(post => post.slug === page.slug) && page.slug !== 'blog').map((page) => ({
    params: { slug: page.slug },
    props: { page },
  })), ...posts.map(post => ({ params: { slug: post.slug }, props: { post } })),
  ...archives.map(archive => ({ params: { slug: archive.slug }, props: { archive } }))];
}

const { page, post, archive } = Astro.props;
const relatedPages = page?.related
  ?.map((slug) => {
    const article = posts.find(candidate => candidate.slug === slug);
    return article ? { ...article, eyebrow: 'From the yard', highlight: '' } : pages.find(candidate => candidate.slug === slug);
  })
  .filter(Boolean);
---

<PageLayout
  title={post ? `${post.title} | West Auckland Storage` : archive ? `${archive.label} — Page ${archive.number} | West Auckland Storage` : `${page.title.replace(".", "")} ${page.highlight} | West Auckland Storage`}
  description={post ? post.excerpt : archive ? `${archive.description} Page ${archive.number} of ${archive.pageCount}.` : page.description}
  type={post ? 'article' : 'website'}
  publishedTime={post?.date}
>
  {post ? <BlogArticle post={post} /> : archive ? <BlogArchive archive={archive} /> : <>
  <main id="main">
    <section class="inner-hero" style={`--hero-image: url("${page.image}")`}>
      <div class="inner-hero-overlay"></div>
      <div class="container inner-hero-content">
        <Breadcrumbs class="breadcrumb" />
        <p class="eyebrow eyebrow-light">{page.eyebrow}</p>
        <h1>{page.title}<br /><em>{page.highlight}</em></h1>
        <p class="hero-lede">{page.description}</p>
      </div>
    </section>

    <section class="page-content section-pad">
      <div class="container page-grid">
        <article class="prose">
          {page.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </section>
          ))}
          {page.kind === "contact" && (
            <div class="contact-details">
              <a class="contact-phone" href="tel:098184586">09 818 4586 <span>↗</span></a>
              <a class="contact-email" href="mailto:info@westaucklandstorage.co.nz">info@westaucklandstorage.co.nz</a>
              <address>20 Akatea Road<br />Glendene, Waitakere 0602</address>
            </div>
          )}
        </article>
        <aside class="page-aside">
          <div class="aside-card">
            <p class="eyebrow">Good to know</p>
            <ul class="check-list check-list-dark">
              {page.bullets.map((bullet) => <li><span aria-hidden="true">+</span><div><strong>{bullet}</strong></div></li>)}
            </ul>
            <a class="button button-bright" href="/contact/">Ask about space <span aria-hidden="true">→</span></a>
          </div>
                </aside>
      </div>
    </section>

    {page.kind === "locations" && (
      <section class="locations-section section-pad">
        <div class="container">
          <div class="section-heading"><div><p class="eyebrow">Find your suburb</p><h2>Local guides for<br /><span>the west.</span></h2></div><p>Every suburb below links to a guide written for owners in that area.</p></div>
          <div class="location-areas">
            {locationGroups.map((group) => (
              <div class="location-area">
                <h3>{group.area}</h3>
                <p class="location-area-blurb">{group.blurb}</p>
                <ul class="location-list">
                  {group.suburbs.map((suburb) => suburb.slug
                    ? <li><a href={`/${suburb.slug}/`}><strong>{suburb.name}</strong><span>{suburb.note}</span></a></li>
                    : <li><span class="location-item"><strong>{suburb.name}</strong><span>{suburb.note}</span></span></li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {page.kind === "contact" && (
      <section class="contact-section section-pad">
        <div class="container contact-grid">
          <div class="contact-intro">
            <p class="eyebrow eyebrow-light">A quick enquiry</p>
            <h2>Start the<br /><em>conversation.</em></h2>
            <p>Fill in the basics and we’ll come back with the next step. It takes about a minute — or call the yard and we’ll sort it over the phone.</p>
          </div>
          <QuoteForm />
        </div>
      </section>
    )}

    {page.slug === 'services' && (
      <section class="storage-section section-pad">
        <div class="container">
          <div class="section-heading"><div><p class="eyebrow">Find the right fit</p><h2>Room for<br /><span>what you own.</span></h2></div><p>Explore the options, then talk to the yard about size, timing and available space.</p></div>
          <div class="service-grid">
            {storageOptions.map((item, index) => <article class="service-card">
              <div class="service-image"><img src={item.image} alt="" loading="lazy" width="640" height="480" /><span class="service-number">{String(index + 1).padStart(2, '0')}</span></div>
              <div class="service-body"><h3>{item.label}</h3><p>{item.description}</p><a class="text-link" href={`/${item.slug}/`}>Explore {item.label.toLowerCase()} <span aria-hidden="true">→</span></a></div>
            </article>)}
          </div>
        </div>
      </section>
    )}

    {page.slug !== 'services' && relatedPages?.length > 0 && (
      <section class="related-section section-pad">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Keep reading</p>
              <h2>More from<br /><span>the yard.</span></h2>
            </div>
          </div>
          <div class="related-grid">
            {relatedPages.slice(0, 3).map((related) => (
              <a class="related-card" href={`/${related.slug}/`}>
                <span class="eyebrow">{related.eyebrow}</span>
                <h3>{related.title} <em>{related.highlight}</em></h3>
                <span class="text-link">Read more <span aria-hidden="true">→</span></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  </>}
</PageLayout>
