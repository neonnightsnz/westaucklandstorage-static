---
import "../styles/global.css";
import { metadataFor, structuredDataFor } from "../data/seo";
import { posts } from "../data/blog";

interface Props {
  title: string;
  description: string;
  home?: boolean;
    type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const { title: suppliedTitle, description: suppliedDescription, home = false, type = 'website', publishedTime, noindex = false } = Astro.props;
const { title, description } = metadataFor(Astro.url.pathname, { title: suppliedTitle, description: suppliedDescription });
const currentPath = Astro.url.pathname;
const SITE_URL = 'https://westaucklandstorage.co.nz';
const site = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, site).href;
const post = posts.find(post => currentPath === `/${post.slug}/`);
const ogImage = new URL(post?.image ?? '/images/og-default.jpg', site).href;
const ogImageAlt = post?.imageAlt || (post ? post.title : 'West Auckland Storage — boat, caravan and vehicle storage in Glendene');
const navigation = [
  { href: '/services/', label: 'What we store' },
  { href: '/about/', label: 'Why us' },
  { href: '/contact/', label: 'Contact' },
];

const structuredData = structuredDataFor(currentPath, title, description, ogImage);
---

<!doctype html>
<html lang="en-NZ">
    <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#145693" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="West Auckland Storage — From the yard" href="/rss.xml" />
    <meta property="og:site_name" content="West Auckland Storage" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!post && <meta property="og:image:width" content="1200" />}
    {!post && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\u003c')} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'interior-header': !home }]}>
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="West Auckland Storage home">
          <img src="/images/logo.png" alt="West Auckland Storage" width="221" height="259" />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="sr-only">Toggle navigation</span>
          <span></span><span></span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main navigation">
          {navigation.map(item => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
          <a class="nav-call" href="tel:098184586">Call 09 818 4586 <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-top">
        <div class="footer-brand-block">
          <a class="brand brand-footer" href="/" aria-label="West Auckland Storage home">
            <img src="/images/logo.png" alt="West Auckland Storage" width="221" height="259" />
          </a>
          <p class="footer-tagline">Keep it close.<br />Keep it sorted.</p>
          <p>Boat, caravan and vehicle storage in Glendene.</p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <h2>Explore</h2>
          <a href="/services/">What we store</a>
          <a href="/about/">Why us</a>
          <a href="/blog/">From the yard</a>
          <a href="/storage-near-you/">Storage near you</a>
          <a href="/sitemap/">Sitemap</a>
        </nav>
        <div class="footer-links">
          <h2>Your account</h2>
          <a href="/pay-your-account/">Pay your account</a>
          <a href="/contact/">Enquiries &amp; invoice help</a>
        </div>
        <div class="footer-contact">
          <h2>Talk to the yard</h2>
          <a class="footer-phone" href="tel:098184586">09 818 4586</a>
          <a href="mailto:info@westaucklandstorage.co.nz">info@westaucklandstorage.co.nz</a>
          <address>Span Farm Boat Yard<br />20 Akatea Road<br />Glendene, Auckland 0602</address>
          <a class="button button-bright" href="/contact/">Ask about space</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© <span data-year>2026</span> West Auckland Storage</span>
        <span>Part of Span Farm Boat Yard Ltd</span>
      </div>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>('.site-header');
      const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
      window.addEventListener('scroll', updateHeader, { passive: true });
      updateHeader();
      const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const siteNav = document.querySelector<HTMLElement>("#site-nav");
      const closeMenu = () => {
        menuToggle?.setAttribute('aria-expanded', 'false');
        siteNav?.classList.remove('is-open');
      };
      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        siteNav?.classList.toggle("is-open", !isOpen);
      });
      siteNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        closeMenu();
      }));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
          closeMenu();
          menuToggle.focus();
        }
      });
      const year = document.querySelector("[data-year]");
      if (year) year.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>
