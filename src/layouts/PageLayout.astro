---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  home?: boolean;
    type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const { title, description, home = false, type = 'website', publishedTime, noindex = false } = Astro.props;
const currentPath = Astro.url.pathname;
const SITE_URL = 'https://westaucklandstorage.co.nz';
const site = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/images/og-default.jpg', site).href;
const navigation = [
  { href: '/services/', label: 'What we store' },
  { href: '/about/', label: 'Why us' },
  { href: '/blog/', label: 'From the yard' },
  { href: '/contact/', label: 'Contact' },
];

// Structured data for local search. NAP mirrors the footer/contact page.
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AutomotiveBusiness',
  name: 'West Auckland Storage',
  description:
    'Boat, caravan, trailer and vehicle storage on outdoor hardstand at Span Farm Boat Yard, Glendene, West Auckland.',
  url: SITE_URL,
  telephone: '+64 9 818 4586',
  email: 'info@westaucklandstorage.co.nz',
  image: ogImage,
  logo: new URL('/images/logo.png', site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '20 Akatea Road, Glendene',
    addressLocality: 'Auckland',
    addressRegion: 'Auckland',
    postalCode: '0602',
    addressCountry: 'NZ',
  },
  // Coordinates declared by the original site's structured data.
  geo: { '@type': 'GeoCoordinates', latitude: -36.890488, longitude: 174.662988 },
  areaServed: ['Glendene', 'Henderson', 'Massey', 'Te Atatu', 'New Lynn', 'Titirangi', 'Kelston', 'Swanson', 'Whenuapai', 'Hobsonville'],
  parentOrganization: { '@type': 'Organization', name: 'Span Farm Boat Yard Ltd' },
  knowsAbout: ['boat storage', 'caravan storage', 'trailer storage', 'vehicle storage', 'outdoor hardstand storage'],
};
---

<!doctype html>
<html lang="en-NZ">
    <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#145693" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="West Auckland Storage — From the yard" href="/rss.xml" />
    <meta property="og:site_name" content="West Auckland Storage" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="West Auckland Storage — boat, caravan and vehicle storage in Glendene" />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'interior-header': !home }]}>
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="West Auckland Storage home">
          <img src="/images/logo.png" alt="West Auckland Storage" width="221" height="259" />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="sr-only">Toggle navigation</span>
          <span></span><span></span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main navigation">
          {navigation.map(item => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
          <a class="nav-call" href="tel:098184586">Call 09 818 4586 <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-top">
        <a class="brand brand-footer" href="/" aria-label="West Auckland Storage home">
          <img src="/images/logo.png" alt="West Auckland Storage" width="221" height="259" />
        </a>
        <p>Secure, affordable storage<br />close to home.</p>
        <div class="footer-links">
          <a href="/services/">What we store</a>
          <a href="/about/">Why us</a>
          <a href="/contact/">Get a quote</a>
          <a href="/blog/">From the yard</a>
          <a href="/storage-near-you/">Storage near you</a>
          <a href="/sitemap/">Sitemap</a>
        </div>
        <div class="footer-address">Span Farm Boat Yard<br />20 Akatea Road, Glendene</div>
      </div>
      <div class="container footer-bottom">
        <span>© <span data-year>2026</span> West Auckland Storage</span>
        <span>Part of Span Farm Boat Yard Ltd</span>
      </div>
    </footer>

    <script>
      const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const siteNav = document.querySelector<HTMLElement>("#site-nav");
      const closeMenu = () => {
        menuToggle?.setAttribute('aria-expanded', 'false');
        siteNav?.classList.remove('is-open');
      };
      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        siteNav?.classList.toggle("is-open", !isOpen);
      });
      siteNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        closeMenu();
      }));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
          closeMenu();
          menuToggle.focus();
        }
      });
      const year = document.querySelector("[data-year]");
      if (year) year.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>
